# Blocks any direct access to this folder.
# Several equivalent rules so it works on Apache 2.2, Apache 2.4 and LiteSpeed (Hostinger).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ - [F]
</IfModule>
